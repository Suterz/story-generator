{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodeBrief v1",
  "type": "object",
  "required": ["schema_version", "id", "topic", "audience", "prior", "tone", "objective", "takeaway", "sources", "misconceptions", "obligation", "transfer"],
  "properties": {
    "schema_version": {"const": "episode/1"},
    "id": {"pattern": "^[0-9]{2}$", "type": "string"},
    "topic": {"$ref": "#/$defs/text"},
    "audience": {"$ref": "#/$defs/text"},
    "prior": {"$ref": "#/$defs/text"},
    "tone": {"$ref": "#/$defs/text"},
    "objective": {"$ref": "#/$defs/text"},
    "takeaway": {"$ref": "#/$defs/text"},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/text"}},
    "misconceptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "editorial_direction": {"$ref": "#/$defs/text"},
    "obligation": {"enum": ["spatial", "worked-example", "source-verification"]},
    "visual_fixture": {"enum": ["seasons", "queue", "percent", "shutter", "study", "map", "salary"]},
    "min_ms": {"enum": [120000, 180000]},
    "question": {"$ref": "#/$defs/text"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "stages": {"$ref": "#/$defs/stages"},
    "chapters": {
      "type": "array", "minItems": 4, "maxItems": 12,
      "items": {"type": "object", "additionalProperties": false,
                "required": ["question", "chapter_claims", "stages", "words"],
                "properties": {"question": {"$ref": "#/$defs/text"},
                               "chapter_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
                               "stages": {"$ref": "#/$defs/stages"}, "words": {"$ref": "#/$defs/text"}}}
    },
    "transfer": {"type": "object", "additionalProperties": false, "required": ["question", "answer"],
                 "properties": {"question": {"$ref": "#/$defs/text"}, "answer": {"$ref": "#/$defs/text"}}}
  },
  "additionalProperties": false,
  "if": {"required": ["chapters"]},
  "then": {"required": ["editorial_direction", "min_ms"]},
  "else": {"required": ["stages", "question", "claims"]},
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "stages": {"type": "array", "minItems": 2, "maxItems": 4,
        "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [
          {"type": "string", "pattern": "^[a-z][a-z-]*$"}, {"$ref": "#/$defs/text"}
        ]}}
  }
}
